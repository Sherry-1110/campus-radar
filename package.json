{
  "name": "campus-radar",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "npm run dev -w @campus-radar/web",
    "build": "npm run build -w @campus-radar/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "sync:events": "npm run sync -w @campus-radar/ingestion --",
    "types:db": "npx supabase gen types typescript --linked > apps/web/src/lib/database.types.ts"
  }
}
