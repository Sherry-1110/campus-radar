# Web app: copy to apps/web/.env.local and fill in. Get the key from the Supabase dashboard:
# Project Settings -> API Keys -> "Publishable key" (safe for browser use; RLS protects data).
# Never put the secret / service_role key in a VITE_ variable or commit it.
VITE_SUPABASE_URL=https://lqirwngvveapraatpibe.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google Maps rendering (the demo key works for the prototype).
# Event coordinates come from the database; ingestion resolves venue addresses.
VITE_GOOGLE_MAPS_API_KEY=
# Optional custom map ID; the prototype defaults to Google's DEMO_MAP_ID.
# VITE_GOOGLE_MAPS_MAP_ID=

# Ingestion pipeline only (GitHub Actions secrets / local), never shipped to the browser:
# SUPABASE_URL=https://lqirwngvveapraatpibe.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# A modern backend secret is also supported and preferred for new credentials:
# SUPABASE_SECRET_KEY=
# GOOGLE_GEOCODING_API_KEY=
